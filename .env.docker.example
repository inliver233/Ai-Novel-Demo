# Copy to .env.docker then fill values.
# NOTE: do NOT commit .env.docker (it may contain secrets).
#
# Generate a Fernet key (required on Linux containers):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

APP_ENV=dev
LOG_LEVEL=INFO

POSTGRES_DB=ainovel
POSTGRES_USER=ainovel
POSTGRES_PASSWORD=

DATABASE_URL=postgresql+psycopg2://ainovel:__POSTGRES_PASSWORD__@postgres:5432/ainovel

SECRET_ENCRYPTION_KEY=
AUTH_SESSION_SIGNING_KEY=

# NOTE:
# - Please keep DATABASE_URL in sync with POSTGRES_* above.
# - __POSTGRES_PASSWORD__ is a placeholder; replace it with POSTGRES_PASSWORD.
